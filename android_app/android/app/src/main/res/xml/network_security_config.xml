<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Autorise le trafic HTTP non chiffré (cleartext) sur le réseau local pour joindre la Livebox TV -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
